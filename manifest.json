{
    "manifest_version": 3,
    "name": "Tranquil Tabs",
    "version": "1.0.0",
    "description": "An Extension to help you use the internet less and less",
    "icons": {
        "128": "Media/icon_128.png",
        "48": "Media/icon_48.png",
        "32": "Media/icon_32.png",
        "16": "Media/icon_16.png"
    },

    "content_scripts": [
        {
            "matches": [ "<all_urls>" ],
            "js": [ "JavaScript/Restriction.js", "JavaScript/Timer.js", "JavaScript/blocking.js"],
            "css": ["CSS/extension.css", "CSS/blocking.css"],
            "run_at": "document_start"
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },

    "permissions": [
        "storage"
    ], 

    "action": {
        "default_title": "Tranquil Tabs",
        "default_popup": "popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "@Tranquil_Tabs"
        }
    }
}