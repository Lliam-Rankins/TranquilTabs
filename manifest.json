{
    "manifest_version": 3,
    "name": "Tranquil Tabs",
    "version": "1.0.0",
    "description": "An Extension to help you use the internet less and less",
    "icons": {
        "128": "Media/icon_128.png",
        "48": "Media/icon_48.png",
        "32": "Media/icon_32.png",
        "16": "Media/icon_16.png"
    },

    "content_scripts": [
        {
            "matches": [ "<all_urls>" ],
            "js": [ "JavaScript/Restriction.js", "JavaScript/content_scripts.js"],
            "css": [ "CSS/extension_style.css"],
            "type": "module",
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "background": {
        "service_worker": "JavaScript/service_worker.js"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },

    "permissions": [
        "storage",
        "offscreen"
    ], 



    "action": {
        "browser_style": true,
        "default_title": "Tranquil Tabs",
        "default_popup": "popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "@Tranquil_Tabs"
        }
    }
}